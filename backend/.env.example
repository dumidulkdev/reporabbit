# Copy to .env and fill in real values. Never commit a real .env.
DATABASE_URL=sqlite:///./reporabbit.db
# For PostgreSQL (docker-compose later):
# DATABASE_URL=postgresql+psycopg2://reporabbit:reporabbit@localhost:5432/reporabbit
SECRET_KEY=change-me-to-a-long-random-string
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
SYNC_INTERVAL_MINUTES=60
STALE_THRESHOLD_DAYS=7
